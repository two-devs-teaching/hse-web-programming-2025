{
    "name": "todo-backend",
    "version": "1.0.0",
    "description": "Simple Todo API backend with Express and TypeScript",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "ts-node src/index.ts",
        "watch": "tsc --watch",
        "lint": "npx eslint \"./src\"",
        "lint:fix": "npx eslint \"./src\" --fix"
    },
    "keywords": ["todo", "api", "express", "typescript"],
    "license": "ISC",
    "dependencies": {
        "express": "^4.18.2",
        "cors": "^2.8.5",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/cors": "^2.8.17",
        "@types/node": "^20.10.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.6",
        "@typescript-eslint/eslint-plugin": "^7.0.2",
        "@typescript-eslint/parser": "^7.0.2",
        "eslint": "^8.56.0",
        "eslint-plugin-import": "^2.29.1",
        "typescript": "^5.3.0",
        "ts-node": "^10.9.0"
    }
}